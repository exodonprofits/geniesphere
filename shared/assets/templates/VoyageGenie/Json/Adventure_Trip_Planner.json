      "id": "bd780b02-5171-4c24-bf04-44a392e1f6e1",
      "name": "Resolve Email Content"
    },
    {
      "parameters": {
        "jsCode": "const url = 'https://exodonprofits.app.n8n.cloud/webhook/send-email';\nconst payload = {\n  resolvedEmail: $json.resolvedEmail,\n  resolvedSubject: $json.resolvedSubject,\n  resolvedMessage: $json.resolvedMessage\n};\n\ntry {\n  const response = await $http({\n    method: 'POST',\n    url: url,\n    body: payload,\n    headers: {\n      'Content-Type': 'application/json'\n    }\n  });\n\n  console.log('Email trigger response:', response);\n} catch (error) {\n  console.error('Error triggering email workflow:', error.message);\n}\n\nreturn $input.all();"
      },
      "id": "bade0e97-c9ad-4d57-a531-23291be05672",
      "name": "Trigger Email Workflow",
      "type": "n8n-nodes-base.code",
