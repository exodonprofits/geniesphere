      "parameters": {
        "jsCode": "const data = $json;\nconsole.log('Incoming form data ($json):', JSON.stringify(data, null, 2));\nreturn [{ json: {\n  departureLocation: data.departureLocation || 'Not specified',\n  destinationCity: data.destinationCity || 'Not specified',\n  accommodationType: data.accommodationType || 'Entire Home',\n  amenities: data.amenities || [],\n  bedrooms: data.bedrooms || '1',\n  bathrooms: data.bathrooms || '1',\n  startDate: data.startDate || 'N/A',\n  endDate: data.endDate || 'N/A',\n  tripType: data.tripType || 'N/A',\n  groupSize: data.groupSize || '1',\n  ageRange: data.ageRange || [],\n  budget: data.budget || '0',\n  email: data.email || 'unknown'\n} }];"
      },
      "name": "Code",
