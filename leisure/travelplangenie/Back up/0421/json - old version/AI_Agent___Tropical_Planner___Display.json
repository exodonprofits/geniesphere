{
  "name": "AI Agent - Tropical Planner - Display",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const data = $json.body;\n\nreturn [{\n  json: {\n    departureLocation: data.departureLocation || \"Not provided\",\n    destination: data.destination || \"Not specified\",\n    budget: data.budget || \"~\",\n    tripType: data.tripType || \"N/A\",\n    groupSize: data.groupSize || \"1\",\n    ageRange: data.ageRange || \"~\",\n    startDate: data.startDate || \"N/A\",\n    endDate: data.endDate || \"N/A\",\n    email: data.email || \"unknown\",\n    display: String(data.display || \"false\").toLowerCase()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4780,
        1620
      ],
      "id": "e372856b-7b0b-4bff-bb60-498e5c73cfe0",
      "name": "Code"
    },
    {
      "parameters": {
        "sendTo": "={{$node[\"Prepare Travel Data\"].json[\"email\"]}}",
        "subject": "=Your AI Travel Plan for {{ $json.destination || \"your next trip\" }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; background-color: #f9f9f9; padding: 20px;\">\n  <h2 style=\"color:#2a4a6e;\">ğŸŒ Trip Plan: {{$node[\"Code\"].json[\"destination\"]}}</h2>\n  <p><strong>Date:</strong> {{$node[\"Code\"].json[\"startDate\"]}} to {{$node[\"Code\"].json[\"endDate\"]}}</p>\n  <p><strong>Departure From:</strong> {{$node[\"Code\"].json[\"departureLocation\"]}}</p>\n  <p><strong>Budget:</strong> ${{$node[\"Code\"].json[\"budget\"]}} (for {{$node[\"Code\"].json[\"groupSize\"]}} people)</p>\n  <hr>\n  <pre style=\"white-space: pre-wrap; font-size: 14px;\">{{$json.itinerary}}</pre>\n  <hr>\n  <p style=\"font-size:12px; color:#999;\">Generated by Voyage Genie âœ¨</p>\n</div>",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        -3380,
        1640
      ],
      "id": "a80a0a76-2b5b-4b38-9694-83476fa43dc1",
      "name": "Gmail",
      "webhookId": "3ba51c9c-58a8-4611-9f90-dbe88cf56c0f",
      "credentials": {
        "gmailOAuth2": {
          "id": "bBXXYTmxaLHTskHO",
          "name": "Gmail account 12"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const {\n  destination,\n  customDestination,\n  startDate,\n  endDate,\n  budget,\n  tripType,\n  groupSize,\n  ageRange,\n  email,\n  departureLocation,\n  display\n} = $json;\n\nconst finalDestination = customDestination || destination;\n\nreturn [{\n  json: {\n    email,\n    destination: finalDestination,\n    departureLocation,\n    startDate,\n    endDate,\n    groupSize,\n    budget,\n    display,\n    prompt: `You are a helpful travel agent. A user is planning a trip and needs your help creating a detailed itinerary.\n\n- Departure location: ${departureLocation || \"Not provided\"}\n- Destination: ${finalDestination}\n- Travel dates: ${startDate} to ${endDate}\n- Budget: $${budget}\n- Trip type: ${tripType}\n- Group size: ${groupSize}\n- Age ranges: ${Array.isArray(ageRange) ? ageRange.join(\", \") : ageRange || \"not specified\"}\n\nCreate a complete itinerary for this trip. Include recommendations for:\n1. Flights (airlines and routes from ${departureLocation || \"the nearest major airport\"})\n2. Accommodation options\n3. Daily schedule with activities\n4. Local food spots\n5. Transportation and travel tips\n\nRespond in a clean and organized layout with sections.`\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4580,
        1620
      ],
      "id": "730d1460-09bf-40a2-814d-fa364cf67665",
      "name": "Prepare Travel Data"
    },
    {
      "parameters": {
        "jsCode": "const travel = $node[\"Prepare Travel Data\"].json;\nconst ai = $node[\"OpenAI\"].json.message?.content || \"No itinerary found.\";\nconst displayValue = String(travel.display);\nconsole.log('Display value before If node:', displayValue);\nreturn [\n  {\n    json: {\n      destination: travel.destination,\n      departureLocation: travel.departureLocation,\n      startDate: travel.startDate,\n      endDate: travel.endDate,\n      groupSize: travel.groupSize,\n      budget: travel.budget,\n      email: travel.email,\n      itinerary: ai,\n      display: displayValue\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3920,
        1620
      ],
      "id": "5d556bcd-d45a-499f-ba1b-3e75fa37d507",
      "name": "Travel Info"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "You are an experienced and helpful AI travel agent. Your goal is to create exciting, practical, and well-organized travel itineraries tailored to each user's preferences. Be friendly, informative, and concise.\n\nWhen suggesting hotels, attractions, restaurants, or tours, include relevant hyperlinks so users can easily click through to book or learn more. Ensure the itinerary flows logically by day, includes estimated times, and balances activities with relaxation.\n\nAlways provide valuable travel tips and local insights to enhance the experience. Format your responses in a clear and readable way using bullet points, headings, and emojis where appropriate to improve readability and engagement.",
              "role": "system"
            },
            {
              "content": "={{$json.prompt}}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
