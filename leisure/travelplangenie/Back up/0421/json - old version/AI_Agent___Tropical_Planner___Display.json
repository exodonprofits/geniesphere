      "parameters": {
        "jsCode": "// In-memory storage for itineraries (for demonstration purposes)\nif (!global.itineraries) {\n  global.itineraries = {};\n}\n\nconst trip = $json;\n\n// Generate a unique ID for this itinerary\nconst itineraryId = Date.now().toString();\n\n// Store the itinerary data\nglobal.itineraries[itineraryId] = {\n  tripTitle: `ğŸŒ Trip Plan: ${trip.destination}`,\n  departure: trip.departureLocation,\n  dates: `${trip.startDate} to ${trip.endDate}`,\n  groupSize: trip.groupSize,\n  budget: `$${trip.budget}`,\n  itinerary: trip.itinerary\n};\n\n// Return a redirect URL with the itinerary ID\nreturn [{\n  headers: {\n    \"Location\": `http://localhost/travel_plan_display_new.html?itineraryId=${itineraryId}`\n  },\n  statusCode: 302\n}];"
      },
