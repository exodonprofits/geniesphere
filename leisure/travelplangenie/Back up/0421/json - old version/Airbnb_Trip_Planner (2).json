    {
      "parameters": {
        "jsCode": "const destination = $json.destinationCity || 'Your Destination'; const travelDates = `${$json.startDate || 'N/A'} to ${$json.endDate || 'N/A'}`; const departure = $json.departureLocation || 'Not specified'; const budget = $json.budget || 'N/A'; const groupSize = $json.groupSize || 'N/A'; const itineraryRaw = $json.itinerary || 'Itinerary details not available.'; const itineraryLines = itineraryRaw.split('\\n'); let itinerary = ''; let inTable = false; let tableRows = []; for (let line of itineraryLines) { line = line.trim(); if (!line) { itinerary += '<br>'; continue; } if (line.startsWith('Flights (2 people)') || line.includes('Flights (2 people)')) { inTable = true; tableRows = []; itinerary += `<strong style=\\\"font-size: 16px; color: #2a4a6e;\\\">${line}</strong><br>`; continue; } if (inTable && (line.startsWith('Total') || line.startsWith('Remaining Budget'))) { const [category, cost] = line.split('\\t').map(item => item.trim()); tableRows.push(`<tr><td style=\\\"border: 1px solid #e0e0e0; padding: 8px; background-color: #f0f0f0;\\\"><strong>${category}</strong></td><td style=\\\"border: 1px solid #e0e0e0; padding: 8px; background-color: #f0f0f0;\\\"><strong>${cost}</strong></td></tr>`); continue; } if (inTable && line.includes('\\t')) { const [category, cost] = line.split('\\t').map(item => item.trim()); tableRows.push(`<tr><td style=\\\"border: 1px solid #e0e0e0; padding: 8px;\\\">${category}</td><td style=\\\"border: 1px solid #e0e0e0; padding: 8px;\\\">${cost}</td></tr>`); continue; } if (inTable && !line.includes('\\t')) { inTable = false; itinerary += `<table style=\\\"border-collapse: collapse; width: 100%; margin: 10px 0;\\\">${tableRows.join('')}</table><br>`; } if (!inTable) { if (line.endsWith(':')) { itinerary += `<strong style=\\\"font-size: 16px; color: #2a4a6e; display: block; margin: 15px 0 5px 0;\\\">${line}</strong>`; } else { itinerary += line + '<br>'; } } } if (inTable) { itinerary += `<table style=\\\"border-collapse: collapse; width: 100%; margin: 10px 0;\\\">${tableRows.join('')}</table><br>`; } const subject = `Your Travel Itinerary for ${destination} - Voyage Genie`; const message = `<div style=\\\"font-family: 'Helvetica Neue', Arial, sans-serif; max-width: 600px; margin: 0 auto; background-color: #f7f7f7; padding: 25px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);\\\"> <div style=\\\"background-color: #2a4a6e; padding: 20px; border-radius: 10px 10px 0 0; text-align: center;\\\" > <h1 style=\\\"color: #ffffff; margin: 0; font-size: 28px;\\\" >‚úàÔ∏è Your Travel Itinerary</h1> </div> <div style=\\\"padding: 25px; background-color: #ffffff; border-radius: 0 0 10px 10px;\\\" > <h2 style=\\\"color: #2a4a6e; font-size: 22px; margin: 0 0 15px 0;\\\" >Destination: ${destination}</h2> <p style=\\\"color: #333333; font-size: 16px; margin: 10px 0; line-height: 1.5;\\\" ><strong>Travel Dates:</strong> ${travelDates}</p> <p style=\\\"color: #333333; font-size: 16px; margin: 10px 0; line-height: 1.5;\\\" ><strong>Departing From:</strong> ${departure}</p> <p style=\\\"color: #333333; font-size: 16px; margin: 10px 0; line-height: 1.5;\\\" ><strong>Budget:</strong> $${budget} (for ${groupSize} travelers)</p> <hr style=\\\"border: 0; border-top: 1px solid #e0e0e0; margin: 25px 0;\\\" > <h3 style=\\\"color: #2a4a6e; font-size: 18px; margin: 0 0 15px 0;\\\" >Itinerary Details</h3> <div style=\\\"background-color: #f9f9f9; padding: 20px; border-radius: 6px; font-size: 14px; line-height: 1.6; color: #333333;\\\" >${itinerary}</div> <hr style=\\\"border: 0; border-top: 1px solid #e0e0e0; margin: 25px 0;\\\" > <p style=\\\"color: #666666; font-size: 12px; text-align: center; margin: 0;\\\" >Generated by <strong>Voyage Genie</strong> üåü</p> </div> </div>`; return [{ json: { ...$json, resolvedEmail: $json.email || 'jtran112675@gmail.com', resolvedSubject: subject, resolvedMessage: message } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
