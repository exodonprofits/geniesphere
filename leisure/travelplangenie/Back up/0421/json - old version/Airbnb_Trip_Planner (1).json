    {
      "parameters": {
        "jsCode": "const data = $json.body; return [{ json: { departureLocation: data.departureLocation || 'Not provided', destinationCity: data.destinationCity || 'Not specified', accommodationType: data.accommodationType || 'Entire Home', amenities: data.amenities || [], bedrooms: data.bedrooms || '1', bathrooms: data.bathrooms || '1', budget: data.budget || '~', tripType: data.tripType || 'N/A', groupSize: data.groupSize || '1', ageRange: data.ageRange || '~', startDate: data.startDate || 'N/A', endDate: data.endDate || 'N/A', email: data.email || 'unknown', display: String(data.display || 'false').toLowerCase() } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        1620
      ],
      "id": "code-node",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "const { departureLocation, destinationCity, accommodationType, amenities, bedrooms, bathrooms, startDate, endDate, budget, tripType, groupSize, ageRange, email, display } = $json; return [{ json: { email, departureLocation, destinationCity, accommodationType, amenities, bedrooms, bathrooms, startDate, endDate, groupSize, budget, display, prompt: `You are a helpful travel agent specializing in Airbnb and hotel stays. Your goal is to create exciting, practical, and well-organized travel itineraries tailored to each user's preferences. Be friendly, informative, and concise. - Departure location: ${departureLocation || 'Not provided'} - Destination: ${destinationCity} - Accommodation type: ${accommodationType} - Key amenities: ${Array.isArray(amenities) ? amenities.join(', ') : amenities || 'None specified'} - Number of bedrooms: ${bedrooms} - Number of bathrooms: ${bathrooms} - Travel dates: ${startDate} to ${endDate} - Budget: $${budget} - Trip type: ${tripType} - Group size: ${groupSize} - Age ranges: ${Array.isArray(ageRange) ? ageRange.join(', ') : ageRange || 'not specified'}\\n\\nCreate a complete itinerary for this trip focusing on an Airbnb or hotel stay. Include recommendations for:\\n1. Flights (airlines and routes from ${departureLocation || 'the nearest major airport'})\\n2. Accommodation options (specific Airbnb listings or hotels matching the accommodation type, amenities, and room preferences; include estimated cost per night and total cost for the trip, and provide alternatives)\\n3. Daily schedule with activities, dining options, and sights\\n4. Estimated food budget (daily cost and recommendations for dining)\\n5. A cost summary table (flights, accommodation, activities, food, total, and remaining budget)\\n6. Travel tips specific to the destination and Airbnb/hotel experience\\n\\nRespond in a clean and organized layout with sections. Include hyperlinks to Airbnb listings, hotels, attractions, or dining options where relevant.` } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        1620
      ],
      "id": "prepare-airbnb-data",
      "name": "Prepare Airbnb Data"
    },
    {
      "parameters": {
        "modelId": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "content": "You are an experienced and helpful AI travel agent specializing in Airbnb and hotel stays. Your goal is to create exciting, practical, and well-organized travel itineraries tailored to each user's preferences. Be friendly, informative, and concise.\\n\\nWhen suggesting Airbnb listings, hotels, attractions, restaurants, or activities, include relevant hyperlinks so users can easily click through to book or learn more. Ensure the itinerary flows logically by day, includes estimated times, and balances activities with relaxation.\\n\\nAlways provide valuable travel tips and local insights to enhance the experience. Format your responses in a clean and organized layout with bullet points, headings, and emojis where appropriate to improve readability and engagement.",
              "role": "system"
            },
            {
              "content": "={{$json.prompt}}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        -100,
        1620
      ],
      "id": "open-ai-node",
      "name": "OpenAI",
      "credentials": {
        "openAiApi": {
          "id": "hUFF1jkJabK3Ewyn",
          "name": "Voyage Genie"
        }
      }
