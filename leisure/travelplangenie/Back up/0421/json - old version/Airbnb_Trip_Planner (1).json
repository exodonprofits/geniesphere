      "parameters": {
        "jsCode": "const airbnb = $node['Prepare Airbnb Data'].json; const ai = $node['OpenAI'].json.message?.content || 'No itinerary found.'; const displayValue = String(airbnb.display); return [{ json: { destinationCity: airbnb.destinationCity, departureLocation: airbnb.departureLocation, accommodationType: airbnb.accommodationType, amenities: airbnb.amenities, bedrooms: airbnb.bedrooms, bathrooms: airbnb.bathrooms, startDate: airbnb.startDate, endDate: airbnb.endDate, groupSize: airbnb.groupSize, budget: airbnb.budget, email: airbnb.email, itinerary: ai, display: displayValue } }];"
      },
      "type": "n8n-nodes-base.code",
