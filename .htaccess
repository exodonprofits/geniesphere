# GenieSphere web root. Managed in git (repo root .htaccess) and published by
# bluehost-deploy.yml; edits made on the server are overwritten on the next upload.

# Serve the static homepage, not a leftover WordPress index.php.
DirectoryIndex index.html index.php

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
